# ==============================================================================
# Environment Variables Example for mcp-cli
# Copy this file to .env and fill in your actual API keys and tokens:
#   cp .env.example .env
# ==============================================================================

# Twinkle Hub API Key (Get yours at https://hub.twinkleai.tw)
TWINKLE_API_KEY=your_twinkle_api_key_here

# GitHub Fine-grained Personal Access Token (PAT)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# Optional: Windows NPX command override (set to npx.cmd on Windows if needed)
# NPX_CMD=npx.cmd
